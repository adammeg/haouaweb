# Required for doctor sessions (JWT). Use a long random string (32+ chars).
AUTH_SECRET=change-me-to-a-long-random-secret-key

# MongoDB (local example). Database name can also be set via MONGODB_DB_NAME.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=hawae_md

# Optional — IA (/api/ia). Priorité : OpenRouter, sinon OpenAI direct.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=HawaeMD
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Diagnostic reports start at up to 4096 tokens and retry once on truncation
# when this per-request ceiling allows a larger attempt (diagnostic default: 8192).
# IA_MAX_TOKENS=8192
# IA_TEMPERATURE=0.2
# Enable only when the configured provider/model supports strict JSON Schema output.
# IA_STRUCTURED_OUTPUTS=true
# Optional stable secret (32+ characters) for pseudonymous reviewed-case identities.
# Defaults to AUTH_SECRET; rotating the identity key makes the old learning epoch inactive.
# AI_LEARNING_SECRET=

# Wake recognition and device-voice fallback use built-in browser APIs.
# In Hawae > Reglages vocaux, use local French recognition when supported,
# or explicitly authorize the browser speech service. Wake phrase: bonjour assist
# (bonjour assiste is also accepted). Voice starts automatically after permission.

# Spoken answers via OpenRouter (reuses OPENROUTER_API_KEY). Keep OPENROUTER_MODEL
# as a reasoning/chat model; HeyGen is speech output only. No paid fallback.
VOICE_SPEECH_PROVIDER=openrouter
VOICE_SPEECH_MODEL=heygen/heygen-voice-1-turbo:free
VOICE_SPEECH_VOICE=nadine
# The free model is listed as retiring 2026-11-30. Change model/voice explicitly
# to a compatible 44.1 kHz mono PCM model, or set VOICE_SPEECH_PROVIDER=browser.

# Optional native realtime voice (WebRTC). OpenRouter text keys cannot enable audio.
# Requires a direct OpenAI key above or a dedicated VOICE_REALTIME_API_KEY.
# VOICE_REALTIME_ENABLED=true
# VOICE_REALTIME_API_KEY=
# VOICE_REALTIME_MODEL=gpt-realtime-2.1

# Optional — CORS for mobile / Expo (comma-separated origins, or *)
# MOBILE_CORS_ORIGIN=*
# Mobile app lives in ../hawae-md-mobile — see hawae-md-mobile/README.md
# API endpoints: /api/mobile/calendar, /api/mobile/stats
